# Copy to .env.local (Next.js loads it automatically) and fill in.

# --- Database -------------------------------------------------------------
# Real Postgres (recommended for production). When unset, an embedded
# Postgres (PGlite) is stored under DATA_DIR so the app runs with zero setup.
# DATABASE_URL=postgres://user:pass@localhost:5432/bill96
# DATA_DIR=./data

# --- Security -------------------------------------------------------------
# 32+ random characters. Encrypts stored Shopify/WordPress credentials.
# Required in production; in development one is generated under DATA_DIR.
# APP_SECRET=

# Allow scanning localhost / private-network URLs (dev & tests only).
# ALLOW_PRIVATE_URLS=1

# Allow new sign-ups (set to 0 to lock the instance after creating accounts).
# ALLOW_SIGNUP=1

# --- French translation drafts -------------------------------------------
# OPTIONAL. Without a key, the review queue still works; you type translations
# yourself. With a key, Claude drafts fr-CA translations for human review.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# TRANSLATION_PROVIDER=claude   # "mock" = fake drafts, used by automated tests

# --- Scanner --------------------------------------------------------------
# Browser used by Playwright: "chrome" (your installed Google Chrome, works on
# macOS 13) or "chromium" (Playwright's bundled build, needs `npx playwright install chromium`).
# BROWSER_CHANNEL=chrome
# SCAN_CONCURRENCY=2

# --- Free scan funnel (/scan) --------------------------------------------
# HubSpot private-app access token (scope: crm.objects.contacts.write). Each
# email unlock creates or updates a contact. When unset, leads are not pushed
# and the server logs a line instead. See README "Free scan" for the two custom
# contact properties to create in HubSpot.
# HUBSPOT_API_KEY=
# Free scans allowed per IP address per hour.
# PUBLIC_SCAN_IP_LIMIT=5
# Tests only: send HubSpot calls to the fake API in tests/fixtures/server.mjs.
# HUBSPOT_API_BASE=https://api.hubapi.com
